# ==============================================================================
# PatchLine Frontend Environment Variables (.env.example)
#
# Copy this file to .env.local for local development (Next.js loads .env.local
# automatically and it is gitignored).
#
# On Vercel, configure these variables under:
# Project Settings -> Environment Variables.
#
# Note: Variables prefixed with NEXT_PUBLIC_* are inlined into the browser
# JavaScript bundle at build time. Never store private API keys or secrets in them.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Service Endpoints (Public / Browser-accessible)
# ------------------------------------------------------------------------------
# Base URL for Auth Service (authentication, token refresh, user sessions)
# Local: http://localhost:5000 | Production: https://your-auth-service.azurewebsites.net
NEXT_PUBLIC_AUTH_API_URL=http://localhost:5000

# Base URL for Main API Gateway Service (scans, projects, findings, integrations)
# Local: http://localhost:5001 | Production: https://your-main-service.azurewebsites.net
NEXT_PUBLIC_MAIN_API_URL=http://localhost:5001

# Optional Frontend App Origin (used for canonical URLs / OAuth redirect origins)
# Production: https://your-patchline-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Edge Middleware & JWT Session Verification (Server-side Edge runtime only)
# ------------------------------------------------------------------------------
# Base64-encoded RS256 Public Key (must match Auth Service's JWT_PUBLIC_KEY).
# Used by Next.js edge middleware.ts to fast-verify session cookies before rendering.
JWT_PUBLIC_KEY_BASE64=your_base64_encoded_public_key_here

# JWT token claims validation
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=patchline

# Note on Middleware Refresh Flow:
# middleware.ts uses NEXT_PUBLIC_AUTH_API_URL to silently refresh an expired
# access_token via the refresh_token cookie server-side before redirecting to /login.
